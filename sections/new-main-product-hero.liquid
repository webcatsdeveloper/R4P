{% comment %}
  Main Product Hero Section - Fullscreen View Optimization V6
  Matches structural alignment requirements from image_ffe8e4.jpg, image_ffddff.png, and image_ff87e4.png
{% endcomment %}

{% style %}
  /* --- Staggered Micro-Interactions & Transitions --- */
  @keyframes dynamicBlockFadeUp {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes dynamicMainImageReveal {
    0% {
      opacity: 0;
      transform: scale(0.98);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .pet-prod-hero-section {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    max-width: 1420px !important; /* Aligned with science section container */
    margin: 0 auto;
    padding: 180px 24px 30px 34px !important; /* 24px container padding + 150px red box margin */
    color: #111111;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pet-prod-breadcrumbs {
    font-size: 13px;
    color: #777777;
    margin-bottom: 30px;
    animation: dynamicBlockFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .pet-prod-breadcrumbs a {
    color: #777777;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .pet-prod-breadcrumbs a:hover {
    color: #e52d27;
  }

  /* --- Two-Column Balanced Grid Frame --- */
  .pet-prod-main-desktop-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); /* Symmetrical 50% / 50% split balance, minmax prevents content overflow stretching */
    gap: 60px; /* Separation spacing between graphic frame and meta elements */
    align-items: start;
  }

  /* --- Left Media Frame Structural Setup --- */
  .pet-prod-media-gallery-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0; /* Prevents review slider track width from expanding the column */
  }

  .pet-prod-main-display-frame {
    background-color: #fbf1e7;
    border-radius: 28px;
    padding: 0px; /* Removed internal padding to let image hit edges if needed */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    aspect-ratio: 1.05 / 1;
    overflow: hidden;
    animation: dynamicMainImageReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Desktop: show static image, hide slider */
  .pet-prod-static-image-wrapper {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pet-prod-static-image-wrapper img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }

  .pet-prod-main-image-slider-wrapper {
    display: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    border-radius: inherit;
  }

  .pet-prod-main-image-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .pet-prod-image-slide {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pet-prod-image-slide img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
  }

  /* Slider Dots Layer */
  .pet-prod-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    position: absolute;
    bottom: 25px;
    z-index: 3;
  }
  .pet-prod-carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #d1cbd4;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }
  .pet-prod-carousel-dot.active {
    background-color: #e52d27;
    transform: scale(1.1);
  }

  /* Thumbnails Row */
  .pet-prod-dynamic-thumbnails-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
    animation: dynamicBlockFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.15s;
  }

  .pet-prod-thumbnail-node {
    width: 76px;
    height: 76px;
    background-color: #fbf1e7;
    border-radius: 12px;
    cursor: pointer;
    box-sizing: border-box;
    border: 2px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: border-color 0.25s ease, transform 0.2s ease;
  }
  .pet-prod-thumbnail-node:hover {
    transform: translateY(-2px);
  }
  .pet-prod-thumbnail-node.active {
    border-color: #fcc9bd;
  }
  .pet-prod-thumbnail-node img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* --- Integrated Customer Review Slider Section (Cleaned Alignments) --- */
  .pet-prod-review-slider-card {
    background-color: #fbf1e7;
    border-radius: 28px;
    padding: 0;
    position: relative;
    overflow: hidden;
    min-height: 290px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    animation: dynamicBlockFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.3s;
  }

  .pet-prod-review-track-wrapper {
    position: relative;
    display: flex;
    width: 100%;
    flex-grow: 1;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  /* Target 2: Setup slide layout structures to handle seamless transitions and smooth offsets */
  .pet-prod-review-slide {
    display: flex !important;
    align-items: center !important;
    width: 100%;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 40px 220px 0 40px;
    position: relative;
  }

  .pet-prod-review-text-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 20px;
  }

  .pet-prod-review-quote {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.4;
    color: #222222;
    margin: 0 0 20px 0;
    letter-spacing: -0.3px;
  }

  .pet-prod-review-author {
    font-size: 14px;
    font-weight: 700;
    color: #111111;
    margin: 0;
  }

  .pet-prod-review-graphic-container {
    position: absolute;
    bottom: 0;
    right: 20px;
    width: 280px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .pet-prod-review-graphic-container img,
  .pet-prod-review-graphic-container svg {
    height: 100% !important;
    width: 100% !important;
    object-fit: contain !important;
    object-position: bottom right !important;
    display: block;
    margin-bottom: -20px; /* Merges evenly with border radius mask limits */
  }

  .pet-prod-review-pagination-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 5;
    margin: 0;
  }

  .pet-prod-review-pagination-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #d1cbd4;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .pet-prod-review-pagination-dot.is-active {
    background-color: #e52d27;
  }

  /* --- Right Columns Structural Typography Setup --- */
  .pet-prod-meta-buy-column {
    display: flex;
    flex-direction: column;
    padding-top: 10px;
    min-width: 0; /* Ensures right column adheres to the 50% boundary */
  }

  .stagger-node {
    opacity: 0;
    animation: dynamicBlockFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .sn-1 { animation-delay: 0.05s; }
  .sn-2 { animation-delay: 0.1s; }
  .sn-3 { animation-delay: 0.15s; }
  .sn-4 { animation-delay: 0.2s; }
  .sn-5 { animation-delay: 0.25s; }

  .pet-prod-main-title {
    font-size: 30px;
    font-weight: 400;
    margin: 0 0 10px 0;
    color: #111111;
    letter-spacing: -0.5px;
  }

  .pet-prod-rating-row-layout {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .pet-prod-rating-stars-element {
    color: #e52d27;
    font-size: 14px;
    letter-spacing: 1px;
  }
  .jdgm-prev-badge{
    margin-top:20px;
  }
  
  .pet-prod-rating-row-layout .jdgm-preview-badge .jdgm-star,
  .pet-prod-rating-row-layout .jdgm-preview-badge .jm-star-rating__font-icon,
  .pet-prod-rating-row-layout .jdgm-preview-badge .jm-star-rating__font-icon::before,
  .pet-prod-rating-row-layout .jdgm-preview-badge .jm-star-rating__font-icon::after {
    color: #e52d27 !important;
  }
  
  .pet-prod-rating-row-layout .jdgm-widget,
  .pet-prod-rating-row-layout .jdgm-prev-badge {
    display: block !important;
  }
  
  .pet-prod-rating-row-layout .jdgm-prev-badge__text {
    font-size: 12px;
    color: #666666;
    margin-left: 8px;
  }
  .pet-prod-rating-numerical-count {
    font-size: 12px;
    color: #666666;
  }

  .pet-prod-short-summary-text {
    font-size: 14px;
    color: #555555;
    line-height: 1.6;
    margin: 0 0 30px 0;
    max-width: 540px;
  }

  /* --- Fixed Inline Alignment Row: Price & Weight Side-By-Side (image_ffe8e4.jpg) --- */
  .pet-prod-price-and-weight-flex-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 0 35px 0;
  }
  
  .pet-prod-price-inner-stack {
    display: flex;
    flex-direction: column;
  }
  .pet-prod-price-primary-line {
    font-size: 32px;
    font-weight: 800;
    color: #000000;
    letter-spacing: -0.5px;
    line-height: 1;
  }
  .pet-prod-price-tax-disclaimer-line {
    font-size: 11px;
    color: #777777;
    margin-top: 6px;
    font-weight: 500;
  }

  .pet-prod-variant-pill-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: -12px;
  }
  .pet-prod-variant-pill-label {
    font-size: 12px;
    color: #777777;
    font-weight: 400;
  }
  .pet-prod-variant-pill-selection {
    border: 1px solid #e52d27;
    background-color: transparent;
    color: #111111;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 600;
  }

  /* --- Core Operation Form Area (Compact Width Enforcements) --- */
  .pet-prod-action-form-matrix {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 380px;
    margin-bottom: 25px;
  }

  .pet-prod-qty-and-subscribe-row-flex {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  .pet-prod-qty-selector-engine {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #a3a3a3;
    border-radius: 6px;
    padding: 0 10px;
    height: 46px;
    background-color: #ffffff;
  }
  .pet-prod-qty-adjustment-trigger {
    background: none;
    border: none;
    font-size: 16px;
    color: #666666;
    cursor: pointer;
    width: 20px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }
  .pet-prod-qty-value-input-node {
    width: 30px;
    text-align: center;
    border: none;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    background: transparent;
    padding: 0 !important;
    margin: 0 !important;
    -moz-appearance: textfield;
  }
  .pet-prod-qty-value-input-node::-webkit-outer-spin-button,
  .pet-prod-qty-value-input-node::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .pet-prod-qty-value-input-node:focus {
    outline: none;
  }

  .pet-functional-btn {
    width: 100%;
    height: 46px;
    border-radius: 23px;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .pet-functional-btn:active {
    transform: scale(0.99);
  }

  .pet-btn-black-subscribe {
    background-color: #000000;
    color: #ffffff;
    border: none;
  }
  .pet-btn-black-subscribe:hover {
    background-color: #1c1c1c;
  }

  .pet-btn-outline-cart {
    background-color: #ffffff;
    color: #e52d27;
    border: 1px solid #e52d27;
  }
  .pet-btn-outline-cart:hover {
    background-color: #fff4f3;
  }

  .pet-btn-solid-buy {
    background-color: #e52d27;
    color: #ffffff;
    border: none;
  }
  .pet-btn-solid-buy:hover {
    background-color: #cd241f;
  }

  /* --- Secondary Details Area Footer Rows --- */
  .pet-prod-footer-meta-block {
    max-width: 380px;
  }

  .pet-prod-promo-coupon-container {
    font-size: 12px;
    line-height: 1.5;
    color: #555555;
    margin-bottom: 25px;
  }
  .pet-prod-promo-coupon-container a {
    color: #e52d27;
    text-decoration: underline;
    font-weight: 600;
    margin-left: 4px;
  }

  .pet-prod-pdf-guide-row {
    font-size: 13px;
    font-weight: 600;
    color: #222222;
    margin-bottom: 35px;
    border-top: 1px dashed #e2decb;
    padding-top: 20px;
  }
  .pet-prod-pdf-guide-row a {
    color: #e52d27;
    text-decoration: underline;
    margin-left: 4px;
  }

  /* --- Dropdown Accordions Block (Updated from image_ff87e4.png) --- */
  .pet-prod-accordions-container-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pet-accordion-element-node {
    background-color: #fbf1e7;
    border-radius: 12px;
    overflow: hidden;
  }
  .pet-accordion-element-trigger-bar {
    width: 100%;
    padding: 16px 24px;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  .pet-accordion-element-trigger-bar span {
    font-size: 14px;
    font-weight: 0;
    color: #222222;
  }
  .pet-accordion-element-chevron-icon {
    font-size: 11px;
    color: #333333;
    transition: transform 0.3s ease;
  }
  .pet-accordion-element-node.is-open .pet-accordion-element-chevron-icon {
    transform: rotate(180deg);
  }
  .pet-accordion-element-panel-slider {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pet-accordion-element-panel-inner-content {
    padding: 4px 24px 24px 24px;
    font-size: 13px;
    line-height: 1.6;
    color: #444444;
  }
  .pet-accordion-element-panel-inner-content ul {
    margin: 0;
    padding-left: 18px;
  }
  .pet-accordion-element-panel-inner-content li {
    margin-bottom: 8px;
  }

  /* MOBILE RESPONSIVE UPDATES FOR SEAMLESS LOWER PLACEMENT (image_f22179.png) */
  @media (max-width: 991px) {
    .pet-prod-hero-section { padding: 120px 20px 20px 20px!important; } /* Reduced bottom padding from 40px to 20px */
    
    /* Turn parent container into a flex column to handle sequence ordering control settings */
    .pet-prod-main-desktop-grid { 
      display: flex; 
      flex-direction: column; 
      gap: 30px; 
      align-items: stretch; /* Override align-items: start to fill width evenly */
      width: 100%;
    }
    
    /* Dissolve layout frame boundaries to allow children elements to mix directly into the main column flow */
    .pet-prod-media-gallery-container { 
      display: contents;
      align-items:center!important;
    }
    
    /* Assign structural orders to render everything sequentially, sending the review card to the bottom */
    .pet-prod-main-display-frame { 
      order: 1; 
      padding: 20px;
      box-sizing: border-box;
    }
    .pet-prod-static-image-wrapper {
      display: none;
    }
    .pet-prod-main-image-slider-wrapper {
      display: block;
    }
    .pet-prod-image-slide img {
      object-fit: contain;
    }
    .pet-prod-dynamic-thumbnails-strip { 
      order: 2; 
      margin-top: -10px; 
      margin-bottom: 10px; 
      justify-content: center;
    }
    .pet-prod-meta-buy-column { 
      order: 3; 
      align-items: center;
      text-align: center;
    }
    .pet-prod-rating-row-layout {
      flex-direction: column;
      gap: 6px;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px; /* Reduced from 24px */
    }
    
    /* MODIFIED: Adjusted padding to let the image snap perfectly flush with the bottom border mask */
    .pet-prod-review-slider-card { 
      order: 4; 
      margin-top: 20px; 
      padding: 0 !important;
    }

    .pet-prod-price-and-weight-flex-row {
      flex-direction: column;
      gap: 16px;
      align-items: center;
      justify-content: center;
      padding: 5px 0 25px 0; /* Reduced top padding from 20px to 5px, and bottom from 30px to 25px */
      width: 100%;
    }
    .pet-prod-price-inner-stack {
      align-items: center;
    }
    .pet-prod-variant-pill-wrapper {
      margin-top: 0;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .pet-prod-qty-and-subscribe-row-flex {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px; /* Increased from 14px */
      width: 100%;
    }
    .pet-prod-qty-selector-engine {
      width: 130px;
      box-sizing: border-box;
    }
    .pet-btn-black-subscribe {
      width: 70%;
    }
    .pet-functional-btn{
      width: 70%;
    }

    .pet-prod-action-form-matrix, .pet-prod-footer-meta-block {
      max-width: 100%;
      width: 100%;
      align-items: center;
    }

    .pet-prod-promo-coupon-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
    }
    .pet-prod-promo-coupon-container a {
      margin-left: 0;
      display: inline-block;
    }

    .pet-prod-pdf-guide-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
    }
    .pet-prod-pdf-guide-row a {
      margin-left: 0;
      display: inline-block;
    }
    
    .pet-prod-review-track-wrapper {
      display: flex;
      width: 100%;
      transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
      will-change: transform;
    }

    /* MODIFIED: Re-arranged column stacking context on mobile slide frames */
    .pet-prod-review-slide { 
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      padding: 40px 30px 0 30px !important;
    }
    .pet-prod-review-pagination-dots {
      display: none !important;
    }
    .pet-prod-review-graphic-container { 
      position: relative !important;
      right: auto !important;
      bottom: auto !important;
      width: 100% !important;
      height: auto !important;
      display: flex !important;
      justify-content: center !important;
      align-items: flex-end !important;
      margin-top: auto !important;
    }
    
    /* MODIFIED: Restored generous height and bottom boundary placement matching Figma */
    .pet-prod-review-graphic-container img,
    .pet-prod-review-graphic-container svg { 
      margin-bottom: 0 !important; 
      max-height: 270px !important; 
      width: auto !important;
      object-fit: contain !important;
      object-position: bottom center !important;
    }
  }
{% endstyle %}

<section class="pet-prod-hero-section" id="PetProductHeroSection-{{ section.id }}">
  <!-- Breadcrumb Path Tracking Segment -->
  <div class="pet-prod-breadcrumbs">
    <a href="/collections/all">All Product</a> &gt; <span>{{ product.title | default: "Taster Pack - Adult (All Breeds)" }}</span>
  </div>

  <div class="pet-prod-main-desktop-grid">
    
    <!-- LEFT COLUMN - CONTAINER GRAPHIC AREA & REVIEW SLIDER -->
    <div class="pet-prod-media-gallery-container">
      <div class="pet-prod-main-display-frame">
        <!-- Desktop Layout: Static Image (Previous Layout) -->
        <div class="pet-prod-static-image-wrapper">
          {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
          {%- if featured_media != blank -%}
            <img id="PetHeroPrimaryImageDisplay" src="{{ featured_media | image_url: width: 800 }}" data-media-id="{{ featured_media.id }}" alt="{{ product.title | escape }}">
          {%- else -%}
            <img id="PetHeroPrimaryImageDisplay" src="https://cdn.shopify.com/s/files/1/0000/0000/files/placeholder_taster_pack.png?v=1" alt="Template Display Frame Asset">
          {%- endif -%}
        </div>

        <!-- Mobile Layout: Sliding Carousel Track (Touch Drag & Auto Slide) -->
        <div class="pet-prod-main-image-slider-wrapper">
          <div class="pet-prod-main-image-track" id="PetHeroImageTrack">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="pet-prod-image-slide" data-image-index="{{ forloop.index0 }}">
                  <img src="{{ media | image_url: width: 800 }}" data-media-id="{{ media.id }}" alt="{{ product.title | escape }}">
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="pet-prod-image-slide" data-image-index="0">
                <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/placeholder_taster_pack.png?v=1" alt="Template Display Frame Asset">
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Interactive Pagination Dots Array Line -->
        <div class="pet-prod-carousel-dots" id="PetImageCarouselDotsContainer">
          {%- if product.media.size > 0 -%}
