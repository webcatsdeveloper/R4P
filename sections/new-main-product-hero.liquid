<script>
  let currentPetImageIndex = 0;
  let petImageAutoplayInterval = null;
  let isPetImageAutoplayRunning = false;

  function syncActivePetThumbnail(element) {
    if (!element) return;
    const targetUrl = element.getAttribute('data-src');
    const index = parseInt(element.getAttribute('data-index')) || 0;
    currentPetImageIndex = index;

    const nodes = document.querySelectorAll('.pet-prod-thumbnail-node');
    nodes.forEach(n => n.classList.remove('active'));
    element.classList.add('active');

    // Update Desktop static image
    const displayImg = document.getElementById('PetHeroPrimaryImageDisplay');
    if (displayImg && targetUrl) {
      displayImg.style.opacity = '0.4';
      setTimeout(() => {
        displayImg.src = targetUrl;
        displayImg.style.opacity = '1';
      }, 120);
    }

    // Slide Mobile main image track
    const imageTrack = document.getElementById('PetHeroImageTrack');
    if (imageTrack) {
      imageTrack.style.transform = `translateX(-${index * 100}%)`;
    }

    const dots = document.querySelectorAll('.pet-prod-carousel-dot');
    dots.forEach((dot, dIdx) => {
      if (dIdx === index) dot.classList.add('active');
      else dot.classList.remove('active');
    });

    if (!isPetImageAutoplayRunning) {
      startPetImageAutoplay();
    }
  }

  function jumpToPetImageIndex(index) {
    currentPetImageIndex = index;

    // Slide Mobile main image track
    const imageTrack = document.getElementById('PetHeroImageTrack');
    if (imageTrack) {
      imageTrack.style.transform = `translateX(-${index * 100}%)`;
    }

    // Update Desktop static image and thumbnails active class
    const thumbs = document.querySelectorAll('.pet-prod-thumbnail-node');
    thumbs.forEach((thumb) => {
      if (parseInt(thumb.getAttribute('data-index')) === index) {
        thumb.classList.add('active');
        const targetUrl = thumb.getAttribute('data-src');
        const displayImg = document.getElementById('PetHeroPrimaryImageDisplay');
        if (displayImg && targetUrl) {
          displayImg.src = targetUrl;
        }
      } else {
        thumb.classList.remove('active');
      }
    });

    const dots = document.querySelectorAll('.pet-prod-carousel-dot');
    dots.forEach((dot, dIdx) => {
      if (dIdx === index) dot.classList.add('active');
      else dot.classList.remove('active');
    });

    if (!isPetImageAutoplayRunning) {
      startPetImageAutoplay();
    }
  }

  function startPetImageAutoplay() {
    stopPetImageAutoplay();
    if (window.innerWidth > 991) return; // Only auto-slide on mobile responsive screens

    petImageAutoplayInterval = setInterval(() => {
      const slides = document.querySelectorAll('.pet-prod-image-slide');
      if (slides.length <= 1) return;
      currentPetImageIndex = (currentPetImageIndex + 1) % slides.length;
      isPetImageAutoplayRunning = true;
      jumpToPetImageIndex(currentPetImageIndex);
      isPetImageAutoplayRunning = false;
    }, 4000);
  }

  function stopPetImageAutoplay() {
    if (petImageAutoplayInterval) {
      clearInterval(petImageAutoplayInterval);
      petImageAutoplayInterval = null;
    }
  }

  function initPetImageSlider() {
    const sliderCard = document.querySelector('.pet-prod-main-display-frame');
    const wrapper = document.querySelector('.pet-prod-main-image-slider-wrapper');
    const trackWrapper = document.getElementById('PetHeroImageTrack');
    if (sliderCard && trackWrapper && wrapper) {
      let startX = 0;
      let currentX = 0;
      let diffX = 0;
      let isDragging = false;
      let containerWidth = wrapper.offsetWidth;

      sliderCard.addEventListener('touchstart', (e) => {
        stopPetImageAutoplay();
        startX = e.touches[0].clientX;
        diffX = 0;
        isDragging = true;
        trackWrapper.style.transition = 'none';
        containerWidth = wrapper.offsetWidth || 300;
      }, { passive: true });

      sliderCard.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        diffX = startX - currentX;
        const baseTranslate = -currentPetImageIndex * 100;
        const dragTranslate = baseTranslate - (diffX / containerWidth * 100);
        trackWrapper.style.transform = `translateX(${dragTranslate}%)`;
      }, { passive: true });

      sliderCard.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        trackWrapper.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
        const slides = document.querySelectorAll('.pet-prod-image-slide');
        if (slides.length > 1 && Math.abs(diffX) > 50) {
          if (diffX > 0) {
            currentPetImageIndex = (currentPetImageIndex + 1) % slides.length;
          } else {
            currentPetImageIndex = (currentPetImageIndex - 1 + slides.length) % slides.length;
          }
        }
        jumpToPetImageIndex(currentPetImageIndex);
        startPetImageAutoplay();
      });
    }
    startPetImageAutoplay();
  }

  /* --- Review Slider Functionality Core --- */
  let currentReviewIndex = 0;
  let reviewAutoplayInterval = null;
  let isAutoplayRunning = false;

  function switchReviewSlide(targetIndex) {
    currentReviewIndex = targetIndex;
    const trackWrapper = document.querySelector('.pet-prod-review-track-wrapper');
    if (trackWrapper) {
      trackWrapper.style.transform = `translateX(-${targetIndex * 100}%)`;
    }

    const dots = document.querySelectorAll('.pet-prod-review-pagination-dot');
    dots.forEach((dot) => {
      dot.classList.remove('is-active');
      if (parseInt(dot.getAttribute('data-target-review')) === targetIndex) {
        dot.classList.add('is-active');
      }
    });

    if (!isAutoplayRunning) {
      startReviewAutoplay();
    }
  }

  function startReviewAutoplay() {
    stopReviewAutoplay();
    reviewAutoplayInterval = setInterval(() => {
      const slides = document.querySelectorAll('.pet-prod-review-slide');
      if (slides.length <= 1) return;
      currentReviewIndex = (currentReviewIndex + 1) % slides.length;
      isAutoplayRunning = true;
      switchReviewSlide(currentReviewIndex);
      isAutoplayRunning = false;
    }, 4000);
  }

  function stopReviewAutoplay() {
    if (reviewAutoplayInterval) {
      clearInterval(reviewAutoplayInterval);
      reviewAutoplayInterval = null;
    }
  }

  function initReviewSlider() {
    const sliderCard = document.querySelector('.pet-prod-review-slider-card');
    const trackWrapper = document.querySelector('.pet-prod-review-track-wrapper');
    if (sliderCard && trackWrapper) {
      let startX = 0;
      let currentX = 0;
      let diffX = 0;
      let isDragging = false;
      let containerWidth = sliderCard.offsetWidth;

      sliderCard.addEventListener('touchstart', (e) => {
        stopReviewAutoplay();
        startX = e.touches[0].clientX;
        diffX = 0;
        isDragging = true;
        trackWrapper.style.transition = 'none';
        containerWidth = sliderCard.offsetWidth || 300;
      }, { passive: true });

      sliderCard.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        diffX = startX - currentX;
        const baseTranslate = -currentReviewIndex * 100;
        const dragTranslate = baseTranslate - (diffX / containerWidth * 100);
        trackWrapper.style.transform = `translateX(${dragTranslate}%)`;
      }, { passive: true });

      sliderCard.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        trackWrapper.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
        const slides = document.querySelectorAll('.pet-prod-review-slide');
        if (slides.length > 1 && Math.abs(diffX) > 50) {
          if (diffX > 0) {
            currentReviewIndex = (currentReviewIndex + 1) % slides.length;
          } else {
            currentReviewIndex = (currentReviewIndex - 1 + slides.length) % slides.length;
          }
        }
        switchReviewSlide(currentReviewIndex);
        startReviewAutoplay();
      });
    }
    startReviewAutoplay();
  }

  // Initialize both sliders
  function initAllSliders() {
    initPetImageSlider();
    initReviewSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllSliders);
  } else {
    initAllSliders();
  }

  // Handle Shopify customizer reloads
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail.sectionId === '{{ section.id }}' || event.target.contains(document.querySelector('.pet-prod-main-display-frame')) || event.target.contains(document.querySelector('.pet-prod-review-slider-card'))) {
      initAllSliders();
    }
  });

  function executeLocalQuantityOffset(amount) {
    const inputNode = document.getElementById('PetHeroFormQuantityInput');
    if (!inputNode) return;
    let computedVal = parseInt(inputNode.value) || 1;
    computedVal += amount;
    if (computedVal < 1) computedVal = 1;
    inputNode.value = computedVal;
  }

  function triggerAddToCartAjaxAction(buttonElement) {
    const originalText = buttonElement.innerText;
    buttonElement.innerText = "ADDING TO CART...";
    
    const variantId = document.getElementById('PetVariantHiddenIdField').value;
    const qty = document.getElementById('PetHeroFormQuantityInput').value;

    let formData = { 'items': [{ 'id': parseInt(variantId), 'quantity': parseInt(qty) }] };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      buttonElement.innerText = "ADDED TO CART!";
      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: data }));
      setTimeout(() => { buttonElement.innerText = originalText; }, 1800);
    })
    .catch((error) => {
      console.error('Ajax operational asset error:', error);
      buttonElement.innerText = originalText;
    });
  }

  function triggerDirectInstantCheckoutAction() {
    const cartForm = document.getElementById('PetProductCoreFormElement');
    if (cartForm) {
      const inputCheckout = document.createElement('input');
      inputCheckout.type = 'hidden';
      inputCheckout.name = 'return_to';
      inputCheckout.value = '/checkout';
      cartForm.appendChild(inputCheckout);
      cartForm.submit();
    }
  }

  function triggerSubscribeAction(isCustomerLoggedIn) {
    if (!isCustomerLoggedIn) {
      window.location.href = "/account/login?return_to=" + encodeURIComponent(window.location.pathname);
    } else {
      alert("Redirecting to your automated recurrent subscription account configurations dashboard line panel.");
    }
  }

  function executeAccordionToggleTrigger(buttonNode) {
    const containerNode = buttonNode.closest('.pet-accordion-element-node');
    const displayPanel = containerNode.querySelector('.pet-accordion-element-panel-slider');

    if (containerNode.classList.contains('is-open')) {
      // Transition out of max-height: none on load smoothly
      if (displayPanel.style.maxHeight === 'none' || displayPanel.style.maxHeight === '') {
        displayPanel.style.maxHeight = displayPanel.scrollHeight + 'px';
        displayPanel.offsetHeight; // force reflow
      }
      setTimeout(() => {
        displayPanel.style.maxHeight = '0px';
      }, 10);
      containerNode.classList.remove('is-open');
    } else {
      // Close all other open accordions in the same container stack
      const siblingNodes = containerNode.parentElement.querySelectorAll('.pet-accordion-element-node.is-open');
      siblingNodes.forEach(sibling => {
        if (sibling !== containerNode) {
          const siblingPanel = sibling.querySelector('.pet-accordion-element-panel-slider');
          if (siblingPanel) {
            if (siblingPanel.style.maxHeight === 'none' || siblingPanel.style.maxHeight === '') {
              siblingPanel.style.maxHeight = siblingPanel.scrollHeight + 'px';
              siblingPanel.offsetHeight; // force reflow
            }
            setTimeout(() => {
              siblingPanel.style.maxHeight = '0px';
            }, 10);
          }
          sibling.classList.remove('is-open');
        }
      });

      displayPanel.style.maxHeight = displayPanel.scrollHeight + "px";
      containerNode.classList.add('is-open');
    }
  }
</script>

